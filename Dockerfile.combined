FROM python:3.11-slim

WORKDIR /app

# Install Nginx and Python dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir flask flask-cors psycopg2-binary gunicorn

# Copy app files
COPY app.py .
COPY index.html .
COPY nginx.conf /etc/nginx/nginx.conf

# Expose ports
EXPOSE 5000 80

# Startup script to run both Flask and Nginx
RUN echo '#!/bin/bash\n\
gunicorn --bind 127.0.0.1:5000 --workers 2 --timeout 30 app:app &\n\
nginx -g "daemon off;"\n\
' > /start.sh && chmod +x /start.sh

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1

CMD ["/start.sh"]
